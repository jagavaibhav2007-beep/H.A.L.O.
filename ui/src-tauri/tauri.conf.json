{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ui",
  "version": "0.1.0",
  "identifier": "com.halo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "orb",
        "title": "Halo",
        "url": "index.html",
        "width": 64,
        "height": 64,
        "minWidth": 32,
        "minHeight": 32,
        "maxWidth": 128,
        "maxHeight": 128,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "Halo",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "peek",
        "title": "Halo",
        "url": "index.html",
        "width": 280,
        "height": 96,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
